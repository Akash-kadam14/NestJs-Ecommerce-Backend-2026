// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
 id Int @id @default(autoincrement())
firstName String
lastName  String
email String @unique
password String
mobileNumber String
role Role @default(USER)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
address String
  userSessions UserSession[]
}

enum Role { 
  USER 
  ADMIN 
}

model UserSession {
  sessionId        String   @id @default(uuid())
  userId           Int //this is the actual column that will be created in your PostgreSQL database table
  user             User     @relation(fields: [userId], references: [id])  // This does not exist as a column in your actual database. Instead, it is used by      
  
  // Prisma in your TypeScript code to let you easily retrieve the connected User object   
  // @relation(fields: [userId], references: [id]) is a configuration that tells Prisma:
  //"Link the user relation field by matching the value in the database column userId with the id column of the User model."
  
  refreshTokenHash String 
  device           String
  userAgent        String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([userId, refreshTokenHash, expiresAt]) // composite index for finding session using multiple conditions
}


model Category {
  id Int @id @default(autoincrement())
  name String
  slug String @unique
  description String ?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]

    @@index([id, isActive]) // composite index
}

model Product {
  id Int @id @default(autoincrement())
  name String
  categoryId Int 
  category  Category @relation(fields: [categoryId], references: [id])
  price Float
  description String?
  image String?
  rating Float @default(0)
  stock Int
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}